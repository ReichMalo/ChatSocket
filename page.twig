<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ title }}</title>
	<style>
		* { box-sizing: border-box; }
		body { margin: 0; font: 16px system-ui, sans-serif; background: #f3f4f6; color: #111827; }
		.chat { display: flex; flex-direction: column; width: min(100%, 640px); height: 100vh; margin: auto; background: #fff; }
		header { padding: 1rem; color: #fff; background: #2563eb; font-weight: 600; }
		#messages { flex: 1; overflow-y: auto; padding: 1rem; list-style: none; margin: 0; }
		#messages li { width: fit-content; max-width: 85%; margin: .5rem 0; padding: .65rem .85rem; border-radius: 1rem; background: #e5e7eb; }
		#messages li.system { max-width: 100%; margin: .75rem auto; padding: 0; color: #6b7280; background: transparent; font-size: .9rem; text-align: center; }
		#messages strong { display: block; margin-bottom: .2rem; font-size: .85rem; color: #2563eb; }
		form { display: flex; gap: .5rem; padding: 1rem; border-top: 1px solid #e5e7eb; }
		input { flex: 1; min-width: 0; padding: .7rem; border: 1px solid #d1d5db; border-radius: .5rem; font: inherit; }
		button { padding: .7rem 1rem; border: 0; border-radius: .5rem; color: #fff; background: #2563eb; cursor: pointer; }
		#join-form { display: flex; gap: .5rem; padding: 1rem; border-bottom: 1px solid #e5e7eb; }
		#join-form input { min-width: 0; }
		#chat-form { display: none; }
		.joined #join-form { display: none; }
		.joined #chat-form { display: flex; }
		#status { padding: .5rem 1rem; color: #b91c1c; font-size: .9rem; }
	</style>
</head>
<body>
	<main class="chat">
		<header>Chat</header>
		<p id="status" hidden role="status"></p>
		<form id="join-form">
			<input id="username" type="text" placeholder="Choisissez un pseudo" maxlength="30" autocomplete="nickname" required>
			<button type="submit">Rejoindre</button>
		</form>
		<ul id="messages" aria-live="polite"></ul>
		<form id="chat-form">
			<input id="message" type="text" placeholder="Votre message…" autocomplete="off" required>
			<button type="submit">Envoyer</button>
		</form>
	</main>
	<script src="/socket.io/socket.io.js"></script>
	<script type="module" src="/chatSocket.js"></script>
</body>
</html>
