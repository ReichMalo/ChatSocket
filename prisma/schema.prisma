generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(30)
  text      String   @db.VarChar(500)
  system    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}