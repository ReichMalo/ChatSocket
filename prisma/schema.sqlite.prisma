generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  username  String
  text      String
  system    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}